@@ -0,0 +1,64 @@
+// 画面全体の見た目（Mantine のテーマ）。色・角の丸み・書体・表の詰め具合はここで一括して決める。
+// 部品ごとに className や style で上書きせず、変えたいときはこのファイルを直す。
+
+import { createTheme, Table, TableScrollContainer, virtualColor, type MantineColorsTuple } from "@mantine/core";
+
+/**
+ * ブランドカラー #0F766E を 7 番目に置いた 10 段階の色。
+ * 0 が最も明るく、9 が最も暗い。
+ */
+const brand: MantineColorsTuple = [
+  "#f0fdfa",
+  "#ccfbf1",
+  "#99f6e4",
+  "#5eead4",
+  "#2dd4bf",
+  "#14b8a6",
+  "#0d9488",
+  "#0f766e", // ブランドカラー
+  "#115e59",
+  "#134e4a",
+];
+
+/** 本文の書体。next/font で読み込んだ Noto Sans JP を CSS 変数で受け取る（app/layout.tsx）。 */
+const fontFamily =
+  'var(--font-noto-sans-jp), "Hiragino Sans", "Hiragino Kaku Gothic ProN", Meiryo, system-ui, sans-serif';
+
+export const theme = createTheme({
+  colors: {
+    brand,
+    // 主色。ライト・ダークで同じ brand を指す「仮想の色」にしておくと、
+    // ボタンの文字色（白か黒か）をモードごとに選び直してくれる。
+    primary: virtualColor({ name: "primary", light: "brand", dark: "brand" }),
+  },
+  primaryColor: "primary",
+  // ライトモードはブランドカラーそのもの（白文字とのコントラスト 5.5:1）。
+  // ダークモードは暗い背景で沈まないよう明るい段階にする（背景とのコントラスト 6.2:1、黒文字とのコントラスト 8.4:1）。
+  primaryShade: { light: 7, dark: 5 },
+  // 明るい色のボタンでは文字を黒にする（ダークモードの主色のボタンで効く）
+  autoContrast: true,
+
+  // ボタン・入力欄・カードなどの角の丸みを 4px にそろえる
+  radius: { xs: "2px", sm: "4px" },
+  defaultRadius: "sm",
+
+  fontFamily,
+  headings: { fontFamily },
+
+  components: {
+    // 表は行の高さを詰めて、1 画面に多くの行を出す
+    Table: Table.extend({
+      defaultProps: {
+        verticalSpacing: 4,
+        horizontalSpacing: "sm",
+        fz: "sm",
+        tabularNums: true,
+        highlightOnHover: true,
+      },
+    }),
+    // 横にはみ出す表はブラウザ標準のスクロールにする（独自スクロールバーぶんの余白を表の下に作らない）
+    TableScrollContainer: TableScrollContainer.extend({
+      defaultProps: { type: "native" },
+    }),
+  },
+});
diff --git a/lib/analytics.ts b/lib/analytics.ts
new file mode 100644
index 0000000..49ce340
--- /dev/null
+++ b/lib/analytics.ts
@@ -0,0 +1,84 @@
+// Google Analytics（gtag.js）の同意管理とイベント送信（ブラウザでだけ使う）。
+// 利用者が同意するまでは gtag.js を読み込まず、dataLayer も作らないので、計測は一切送らない。
+
+import { PUNCH_LABEL } from "./punch";
+import type { PunchAction } from "./types";
+
+export const GA_MEASUREMENT_ID = process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID || "G-XXXXXXXXXX";
+
+export type AnalyticsConsent = "granted" | "denied";
+
+const CONSENT_KEY = "analytics-consent";
+const CONSENT_EVENT = "analytics-consent-change";
+
+type Gtag = (...args: unknown[]) => void;
+
+declare global {
+  interface Window {
+    dataLayer?: unknown[];
+    gtag?: Gtag;
+  }
+}
+
+/** 保存された同意の状態。まだ選んでいなければ null。 */
+export function getConsent(): AnalyticsConsent | null {
+  try {
+    const value = window.localStorage.getItem(CONSENT_KEY);
+    return value === "granted" || value === "denied" ? value : null;
+  } catch {
+    // プライベートモードなどで localStorage が使えないときは、未選択として扱う
+    return null;
+  }
+}
+
+export function setConsent(consent: AnalyticsConsent): void {
+  try {
+    window.localStorage.setItem(CONSENT_KEY, consent);
+  } catch {
+    // 保存できなくても、この画面を開いている間は選んだ状態で動かす
+  }
+  window.dispatchEvent(new CustomEvent<AnalyticsConsent>(CONSENT_EVENT, { detail: consent }));
+}
+
+/** 同意の状態の変化を購読する（useSyncExternalStore 用）。別のタブでの変更も拾う。 */
+export function subscribeConsent(onChange: () => void): () => void {
+  const onStorage = (e: StorageEvent) => e.key === CONSENT_KEY && onChange();
+  window.addEventListener(CONSENT_EVENT, onChange);
+  window.addEventListener("storage", onStorage);
+  return () => {
+    window.removeEventListener(CONSENT_EVENT, onChange);
+    window.removeEventListener("storage", onStorage);
+  };
+}
+
+/**
+ * gtag を用意して初期設定を積む。同意したあとに一度だけ呼ぶ。
+ * gtag.js 本体は、この後に読み込まれたときに dataLayer に積まれた命令を順に送る。
+ */
+export function initAnalytics(measurementId: string = GA_MEASUREMENT_ID): void {
+  if (window.gtag) return;
+  window.dataLayer = window.dataLayer || [];
+  // gtag.js は配列ではなく arguments オブジェクトが積まれることを前提にしている
+  window.gtag = function gtag() {
+    // eslint-disable-next-line prefer-rest-params
+    window.dataLayer!.push(arguments);
+  };
+  // 同意を得たのはアクセス解析だけなので、広告に関わる保存・利用は拒否のままにする
+  window.gtag("consent", "default", {
+    analytics_storage: "granted",
+    ad_storage: "denied",
+    ad_user_data: "denied",
+    ad_personalization: "denied",
+  });
+  window.gtag("js", new Date());
+  window.gtag("config", measurementId);
+}
+
+/** 打刻したことを送る。同意していなければ何もしない。 */
+export function trackPunch(action: PunchAction): void {
+  if (getConsent() !== "granted" || !window.gtag) return;
+  window.gtag("event", "punch", {
+    punch_type: PUNCH_LABEL[action],
+    punch_action: action,
+  });
+}
